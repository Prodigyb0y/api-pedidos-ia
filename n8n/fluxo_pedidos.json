            "texto_original": "={{ $(\"Formulário de pedido\").item.json.texto ?? $(\"Formulário de pedido\").item.json[\"Texto do pedido\"] }}",
            "status": "={{ $json.erro ? ($json.erro.codigo === \"pedido_sem_item\" ? \"pedido_sem_item\" : ([\"limite_diario\", \"teto_de_gasto\"].includes($json.erro.codigo) ? \"bloqueado\" : \"revisar\")) : $json.status }}",
            "codigo_erro": "={{ $json.erro?.codigo ?? \"\" }}",
            "solicitante_area": "={{ $json.dados?.solicitante_area ?? \"\" }}",

{
  "name": "Pedidos de compra - API Gutenberg",
  "nodes": [
    {
      "parameters": {
        "formTitle": "Pedido de compra",
        "formDescription": "Cole o texto livre do pedido. A API extrai os campos e avisa o que falta.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Texto do pedido",
              "fieldType": "textarea",
              "fieldName": "texto",
              "placeholder": "O Almoxarifado precisa de 25 kg de detergente industrial ate 05/01/2027.",
              "requiredField": true
            },
            {
              "fieldLabel": "E-mail do solicitante",
              "fieldType": "email",
              "fieldName": "email_solicitante",
              "placeholder": "nome@gutenberg-systems.example",
              "requiredField": true
            }
          ]
        },
        "options": {
          "appendAttribution": false,
          "buttonLabel": "Enviar pedido",
          "path": "pedido-compra",
          "respondWithOptions": {
            "values": {
              "formSubmittedText": "Pedido recebido. Se faltar alguma informação, você recebe um e-mail."
            }
          }
        }
      },
      "name": "Formulário de pedido",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        240,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api-pedidos-mu.vercel.app/api/v1/processar",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-id-pedido",
              "value": "=pedido-{{ $execution.id }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { \"texto\": $json.texto ?? $json[\"Texto do pedido\"] } }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "name": "Processar pedido na API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        544,

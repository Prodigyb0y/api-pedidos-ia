# Copie para .env só se for rodar localmente. Na Vercel, cadastre em Settings → Environment Variables.
# Chave da Anthropic (usada só no servidor).
ANTHROPIC_API_KEY=
# Chaves de acesso à API: apelido:segredo, separadas por vírgula. Segredo com 12 caracteres ou mais.
API_KEYS=n8n:troque-por-um-segredo-longo,demo:troque-por-outro-segredo
# Teto de gasto do mês com o modelo, em US$.
TETO_GASTO_USD=0.50
# Chamadas por dia para cada chave.
LIMITE_DIARIO_POR_CHAVE=200
# Chamadas por dia, no total, para a página de demonstração (rota /api/demo, sem chave).
LIMITE_DIARIO_DEMO=30
# Opcional: Upstash Redis (integração da Vercel). Sem isto, contadores e log ficam em memória.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
